{
  "$defs": {
    "MarkerObservation": {
      "additionalProperties": false,
      "properties": {
        "comparator": {
          "default": "eq",
          "enum": [
            "eq",
            "lt",
            "le",
            "gt",
            "ge"
          ],
          "title": "Comparator",
          "type": "string"
        },
        "date": {
          "title": "Date",
          "type": "string"
        },
        "marker": {
          "enum": [
            "AFP",
            "DCP"
          ],
          "title": "Marker",
          "type": "string"
        },
        "original_unit": {
          "default": "",
          "title": "Original Unit",
          "type": "string"
        },
        "parse_status": {
          "enum": [
            "exact",
            "censored",
            "missing",
            "invalid",
            "unsupported_unit"
          ],
          "title": "Parse Status",
          "type": "string"
        },
        "quality_status": {
          "enum": [
            "pass",
            "warning",
            "fail",
            "unavailable"
          ],
          "title": "Quality Status",
          "type": "string"
        },
        "reference_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference High"
        },
        "reference_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Low"
        },
        "source_text": {
          "title": "Source Text",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "upper_reference": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Reference"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "date",
        "marker",
        "value",
        "unit",
        "parse_status",
        "source_text",
        "quality_status"
      ],
      "title": "MarkerObservation",
      "type": "object"
    },
    "MarkerTrend": {
      "additionalProperties": false,
      "properties": {
        "censored_observation_count": {
          "title": "Censored Observation Count",
          "type": "integer"
        },
        "change_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Change Pct"
        },
        "direction": {
          "enum": [
            "rising",
            "falling",
            "stable",
            "insufficient",
            "indeterminate"
          ],
          "title": "Direction",
          "type": "string"
        },
        "exact_observation_count": {
          "title": "Exact Observation Count",
          "type": "integer"
        },
        "interval_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Interval Days"
        },
        "latest_above_upper": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest Above Upper"
        },
        "latest_comparator": {
          "anyOf": [
            {
              "enum": [
                "eq",
                "lt",
                "le",
                "gt",
                "ge"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest Comparator"
        },
        "latest_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest Value"
        },
        "marker": {
          "enum": [
            "AFP",
            "DCP"
          ],
          "title": "Marker",
          "type": "string"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/MarkerObservation"
          },
          "title": "Observations",
          "type": "array"
        },
        "quality_status": {
          "enum": [
            "pass",
            "warning",
            "fail",
            "unavailable"
          ],
          "title": "Quality Status",
          "type": "string"
        },
        "uncertainty": {
          "items": {
            "type": "string"
          },
          "title": "Uncertainty",
          "type": "array"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "upper_reference": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upper Reference"
        }
      },
      "required": [
        "marker",
        "observations",
        "latest_value",
        "latest_comparator",
        "unit",
        "upper_reference",
        "latest_above_upper",
        "direction",
        "change_pct",
        "interval_days",
        "exact_observation_count",
        "censored_observation_count",
        "quality_status"
      ],
      "title": "MarkerTrend",
      "type": "object"
    },
    "QualityCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "warning",
            "fail",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "status",
        "message"
      ],
      "title": "QualityCheck",
      "type": "object"
    },
    "QualityEvidence": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/QualityCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "image_mask_aligned": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Mask Aligned"
        },
        "spacing_mm": {
          "items": {
            "type": "number"
          },
          "title": "Spacing Mm",
          "type": "array"
        },
        "status": {
          "enum": [
            "pass",
            "warning",
            "fail",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "QualityEvidence",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "data_origin": {
          "default": "unknown",
          "title": "Data Origin",
          "type": "string"
        },
        "deidentified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deidentified"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "title": "Source Type",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "source_id",
        "source_type"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "markers": {
      "additionalProperties": {
        "$ref": "#/$defs/MarkerTrend"
      },
      "title": "Markers",
      "type": "object"
    },
    "patient_id": {
      "title": "Patient Id",
      "type": "string"
    },
    "pipeline_version": {
      "default": "0.4.0",
      "title": "Pipeline Version",
      "type": "string"
    },
    "provenance": {
      "additionalProperties": true,
      "title": "Provenance",
      "type": "object"
    },
    "quality": {
      "$ref": "#/$defs/QualityEvidence"
    },
    "rejected_observations": {
      "items": {
        "$ref": "#/$defs/MarkerObservation"
      },
      "title": "Rejected Observations",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "title": "Sources",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "patient_id",
    "markers",
    "quality",
    "warnings",
    "provenance"
  ],
  "title": "LabEvidence",
  "type": "object"
}
