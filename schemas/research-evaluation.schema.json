{
  "$defs": {
    "PatientEndpointResult": {
      "additionalProperties": false,
      "properties": {
        "center_id": {
          "title": "Center Id",
          "type": "string"
        },
        "endpoint_status": {
          "enum": [
            "positive",
            "negative",
            "indeterminate"
          ],
          "title": "Endpoint Status",
          "type": "string"
        },
        "image_only_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Image Only Score"
        },
        "lab_only_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lab Only Score"
        },
        "label": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Label"
        },
        "missing_pattern": {
          "title": "Missing Pattern",
          "type": "string"
        },
        "patient_id": {
          "title": "Patient Id",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "rule_fusion_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rule Fusion Score"
        },
        "scanner_group": {
          "title": "Scanner Group",
          "type": "string"
        },
        "selected_days_after_treatment": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selected Days After Treatment"
        },
        "selected_study_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selected Study Id"
        },
        "split": {
          "enum": [
            "development",
            "external_test"
          ],
          "title": "Split",
          "type": "string"
        },
        "treatment_type": {
          "title": "Treatment Type",
          "type": "string"
        }
      },
      "required": [
        "patient_id",
        "center_id",
        "split",
        "label",
        "endpoint_status",
        "selected_study_id",
        "selected_days_after_treatment",
        "reason_codes",
        "image_only_score",
        "lab_only_score",
        "rule_fusion_score",
        "scanner_group",
        "treatment_type",
        "missing_pattern"
      ],
      "title": "PatientEndpointResult",
      "type": "object"
    },
    "QualityCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "warning",
            "fail",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "status",
        "message"
      ],
      "title": "QualityCheck",
      "type": "object"
    },
    "QualityEvidence": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/QualityCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "image_mask_aligned": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Mask Aligned"
        },
        "spacing_mm": {
          "items": {
            "type": "number"
          },
          "title": "Spacing Mm",
          "type": "array"
        },
        "status": {
          "enum": [
            "pass",
            "warning",
            "fail",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "QualityEvidence",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "data_origin": {
          "default": "unknown",
          "title": "Data Origin",
          "type": "string"
        },
        "deidentified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deidentified"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "title": "Source Type",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "source_id",
        "source_type"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adjudication": {
      "additionalProperties": true,
      "title": "Adjudication",
      "type": "object"
    },
    "baselines": {
      "additionalProperties": true,
      "title": "Baselines",
      "type": "object"
    },
    "bootstrap_iterations": {
      "default": 2000,
      "exclusiveMinimum": 0,
      "title": "Bootstrap Iterations",
      "type": "integer"
    },
    "case_dispositions": {
      "items": {
        "$ref": "#/$defs/PatientEndpointResult"
      },
      "title": "Case Dispositions",
      "type": "array"
    },
    "cohort_id": {
      "title": "Cohort Id",
      "type": "string"
    },
    "configuration_hash": {
      "title": "Configuration Hash",
      "type": "string"
    },
    "endpoint_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Endpoint Counts",
      "type": "object"
    },
    "exploratory_only": {
      "title": "Exploratory Only",
      "type": "boolean"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "git_commit": {
      "title": "Git Commit",
      "type": "string"
    },
    "intended_use": {
      "title": "Intended Use",
      "type": "string"
    },
    "manifest_hash": {
      "title": "Manifest Hash",
      "type": "string"
    },
    "missingness": {
      "additionalProperties": true,
      "title": "Missingness",
      "type": "object"
    },
    "paired_differences": {
      "additionalProperties": true,
      "title": "Paired Differences",
      "type": "object"
    },
    "pipeline_version": {
      "default": "0.4.0",
      "title": "Pipeline Version",
      "type": "string"
    },
    "primary_metric": {
      "const": "auprc",
      "default": "auprc",
      "title": "Primary Metric",
      "type": "string"
    },
    "protocol_hash": {
      "title": "Protocol Hash",
      "type": "string"
    },
    "quality": {
      "$ref": "#/$defs/QualityEvidence"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "enum": [
        "development",
        "external_test"
      ],
      "title": "Scope",
      "type": "string"
    },
    "score_threshold": {
      "default": 0.5,
      "maximum": 1,
      "minimum": 0,
      "title": "Score Threshold",
      "type": "number"
    },
    "sensitivity_analyses": {
      "additionalProperties": true,
      "title": "Sensitivity Analyses",
      "type": "object"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "title": "Sources",
      "type": "array"
    },
    "stratified_results": {
      "additionalProperties": true,
      "title": "Stratified Results",
      "type": "object"
    }
  },
  "required": [
    "cohort_id",
    "scope",
    "protocol_hash",
    "manifest_hash",
    "configuration_hash",
    "git_commit",
    "quality",
    "adjudication",
    "endpoint_counts",
    "case_dispositions",
    "baselines",
    "paired_differences",
    "stratified_results",
    "sensitivity_analyses",
    "missingness",
    "exploratory_only",
    "intended_use"
  ],
  "title": "ResearchEvaluationArtifact",
  "type": "object"
}
