{
  "$defs": {
    "CaseDisposition": {
      "additionalProperties": false,
      "properties": {
        "center_id": {
          "title": "Center Id",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "included",
            "excluded",
            "failed",
            "indeterminate"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "messages": {
          "items": {
            "type": "string"
          },
          "title": "Messages",
          "type": "array"
        },
        "patient_id": {
          "title": "Patient Id",
          "type": "string"
        },
        "phi_findings": {
          "items": {
            "type": "string"
          },
          "title": "Phi Findings",
          "type": "array"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "patient_id",
        "center_id",
        "disposition",
        "reason_codes",
        "messages"
      ],
      "title": "CaseDisposition",
      "type": "object"
    },
    "QualityCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "warning",
            "fail",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "status",
        "message"
      ],
      "title": "QualityCheck",
      "type": "object"
    },
    "QualityEvidence": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/QualityCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "image_mask_aligned": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Mask Aligned"
        },
        "spacing_mm": {
          "items": {
            "type": "number"
          },
          "title": "Spacing Mm",
          "type": "array"
        },
        "status": {
          "enum": [
            "pass",
            "warning",
            "fail",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "QualityEvidence",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "data_origin": {
          "default": "unknown",
          "title": "Data Origin",
          "type": "string"
        },
        "deidentified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deidentified"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "title": "Source Type",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "source_id",
        "source_type"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/CaseDisposition"
      },
      "title": "Cases",
      "type": "array"
    },
    "cohort_id": {
      "title": "Cohort Id",
      "type": "string"
    },
    "counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Counts",
      "type": "object"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "manifest_hash": {
      "title": "Manifest Hash",
      "type": "string"
    },
    "pipeline_version": {
      "default": "0.4.0",
      "title": "Pipeline Version",
      "type": "string"
    },
    "protocol_hash": {
      "title": "Protocol Hash",
      "type": "string"
    },
    "quality": {
      "$ref": "#/$defs/QualityEvidence"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "cohort_id",
    "protocol_hash",
    "manifest_hash",
    "quality",
    "counts",
    "cases"
  ],
  "title": "CohortValidationReport",
  "type": "object"
}
