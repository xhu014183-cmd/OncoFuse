{
  "$defs": {
    "DicomGeometrySummary": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "exclusiveMinimum": 0,
          "title": "Columns",
          "type": "integer"
        },
        "orientation": {
          "items": {
            "type": "number"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Orientation",
          "type": "array"
        },
        "rows": {
          "exclusiveMinimum": 0,
          "title": "Rows",
          "type": "integer"
        },
        "slice_count": {
          "exclusiveMinimum": 0,
          "title": "Slice Count",
          "type": "integer"
        },
        "slice_position_range_mm": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Slice Position Range Mm",
          "type": "array"
        },
        "spacing_mm": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Spacing Mm",
          "type": "array"
        }
      },
      "required": [
        "rows",
        "columns",
        "slice_count",
        "spacing_mm",
        "orientation",
        "slice_position_range_mm"
      ],
      "title": "DicomGeometrySummary",
      "type": "object"
    },
    "ImageToolFinding": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "default": "unavailable",
          "enum": [
            "high",
            "moderate",
            "low",
            "unavailable"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "observation": {
          "title": "Observation",
          "type": "string"
        },
        "reported_max_extent_mm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Max Extent Mm"
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "location",
        "observation",
        "source_ref"
      ],
      "title": "ImageToolFinding",
      "type": "object"
    },
    "QualityCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "warning",
            "fail",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "status",
        "message"
      ],
      "title": "QualityCheck",
      "type": "object"
    },
    "QualityEvidence": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/QualityCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "image_mask_aligned": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Mask Aligned"
        },
        "spacing_mm": {
          "items": {
            "type": "number"
          },
          "title": "Spacing Mm",
          "type": "array"
        },
        "status": {
          "enum": [
            "pass",
            "warning",
            "fail",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "QualityEvidence",
      "type": "object"
    },
    "QuantitativeLesion": {
      "additionalProperties": false,
      "properties": {
        "centroid_world_mm": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Centroid World Mm",
          "type": "array"
        },
        "lesion_id": {
          "title": "Lesion Id",
          "type": "string"
        },
        "max_3d_extent_mm": {
          "exclusiveMinimum": 0,
          "title": "Max 3D Extent Mm",
          "type": "number"
        },
        "source": {
          "enum": [
            "expert_seg",
            "supplied_seg"
          ],
          "title": "Source",
          "type": "string"
        },
        "volume_ml": {
          "exclusiveMinimum": 0,
          "title": "Volume Ml",
          "type": "number"
        }
      },
      "required": [
        "lesion_id",
        "volume_ml",
        "centroid_world_mm",
        "max_3d_extent_mm",
        "source"
      ],
      "title": "QuantitativeLesion",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "data_origin": {
          "default": "unknown",
          "title": "Data Origin",
          "type": "string"
        },
        "deidentified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deidentified"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "title": "Source Type",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "source_id",
        "source_type"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "StudyIdentity": {
      "additionalProperties": false,
      "properties": {
        "frame_of_reference_uid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Frame Of Reference Uid"
        },
        "modality": {
          "enum": [
            "CT",
            "MR"
          ],
          "title": "Modality",
          "type": "string"
        },
        "patient_id": {
          "title": "Patient Id",
          "type": "string"
        },
        "phase": {
          "default": "unknown",
          "title": "Phase",
          "type": "string"
        },
        "sequence_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence Name"
        },
        "series_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Series Description"
        },
        "series_instance_uid": {
          "title": "Series Instance Uid",
          "type": "string"
        },
        "study_date": {
          "title": "Study Date",
          "type": "string"
        },
        "study_instance_uid": {
          "title": "Study Instance Uid",
          "type": "string"
        }
      },
      "required": [
        "patient_id",
        "study_instance_uid",
        "series_instance_uid",
        "frame_of_reference_uid",
        "modality",
        "study_date"
      ],
      "title": "StudyIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "geometry": {
      "$ref": "#/$defs/DicomGeometrySummary"
    },
    "geometry_qc": {
      "$ref": "#/$defs/QualityEvidence"
    },
    "interpretation_mode": {
      "enum": [
        "quantitative_and_qualitative",
        "quantitative_only",
        "qualitative_only",
        "unavailable"
      ],
      "title": "Interpretation Mode",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "modality": {
      "enum": [
        "CT",
        "MR"
      ],
      "title": "Modality",
      "type": "string"
    },
    "patient_id": {
      "title": "Patient Id",
      "type": "string"
    },
    "phase": {
      "title": "Phase",
      "type": "string"
    },
    "pipeline_version": {
      "default": "0.4.0",
      "title": "Pipeline Version",
      "type": "string"
    },
    "provenance": {
      "additionalProperties": true,
      "title": "Provenance",
      "type": "object"
    },
    "qualitative_observations": {
      "items": {
        "$ref": "#/$defs/ImageToolFinding"
      },
      "title": "Qualitative Observations",
      "type": "array"
    },
    "quality": {
      "$ref": "#/$defs/QualityEvidence"
    },
    "quantitative_measurements": {
      "items": {
        "$ref": "#/$defs/QuantitativeLesion"
      },
      "title": "Quantitative Measurements",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "title": "Sources",
      "type": "array"
    },
    "study_date": {
      "title": "Study Date",
      "type": "string"
    },
    "study_identity": {
      "$ref": "#/$defs/StudyIdentity"
    },
    "tool_consistency": {
      "enum": [
        "pass",
        "warning",
        "fail",
        "not_comparable",
        "unavailable"
      ],
      "title": "Tool Consistency",
      "type": "string"
    }
  },
  "required": [
    "patient_id",
    "study_date",
    "modality",
    "phase",
    "interpretation_mode",
    "study_identity",
    "geometry",
    "geometry_qc",
    "quantitative_measurements",
    "qualitative_observations",
    "tool_consistency",
    "limitations",
    "quality",
    "provenance"
  ],
  "title": "ImagingInterpretationEvidence",
  "type": "object"
}
